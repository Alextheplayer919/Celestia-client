<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!--
        The service runs as a foreground service for as long as the tunnel is up.
        Android 14 (targetSdk 34) requires a declared foreground service *type* for
        any FGS; there is no "vpn" type, and systemExempted is reserved for
        system-level VPN integrations, so specialUse is the type for an
        app-installed VpnService.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Since Android 11 an app cannot enumerate the installed apps without the
        restricted QUERY_ALL_PACKAGES permission. Declaring the launcher intent here
        is the sanctioned alternative: it makes the app picker able to list
        launchable apps (Minecraft included) without shipping a restricted
        permission.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.mojang.minecraftpe" />
        <package android:name="com.mojang.minecraftedu" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Celestia">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".MinecraftVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Relays the user's own Minecraft Bedrock UDP traffic in order to show connection statistics for their session." />
        </service>

    </application>
</manifest>
